# Collecte nocturne, lancée par job-rec-ai-crawl.timer (unité systemd du système).
# Installation : voir deploy/README.md
[Unit]
Description=job-rec-ai : collecte des offres d'emploi
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
# oneshot : le service tourne puis s'arrête. systemd ne lance jamais deux collectes en
# parallèle : si la précédente tourne encore, le timer attend (DuckDB n'accepte qu'un écrivain).
Type=oneshot
WorkingDirectory=/opt/job-rec-ai
ExecStart=/usr/bin/docker compose --profile crawl run --rm crawl
# Le rapport qualité suit chaque collecte réussie : il finit dans le journal, avec le reste
ExecStartPost=/usr/bin/docker compose --profile crawl run --rm crawl job-rec-ai quality
# Garde-fou : une collecte normale prend environ 75 minutes
TimeoutStartSec=3h
